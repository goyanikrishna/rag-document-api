  "description": "Document RAG API Backend using Node.js, Express, TS, Prisma, pgvector, and Gemini",
  "main": "dist/server.js",
  "author": "Krishna Goyani",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
