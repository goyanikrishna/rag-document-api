PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_extract?schema=public"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL='YOUR_GEMINI_MODEL'
GEMINI_EMBEDDING_MODEL='YOUR_GEMINI_EMBEDDING_MODEL'
UPLOAD_PATH="uploads"
MAX_UPLOAD_SIZE=20971520 # 20MB
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
# JWT (Required — must be at least 32 characters. No default. Change before deploying.)
JWT_SECRET="your-strong-jwt-secret-at-least-32-characters-long"
JWT_EXPIRES_IN=7d

# Vector similarity search threshold (0.0 to 1.0)
MIN_SIMILARITY_THRESHOLD=0.55

